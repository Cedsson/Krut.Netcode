  <diagram id="wf" name="Wire format">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1310" math="0" shadow="0">
      <root>
        <mxCell id="wf-0"/>
        <mxCell id="wf-1" parent="wf-0"/>
        <mxCell id="wf-title" value="Wire format: one message = one LiteNetLib packet payload" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;fontStyle=1;" vertex="1" parent="wf-1"><mxGeometry x="20" y="4" width="900" height="26" as="geometry"/></mxCell>
        <mxCell id="wf-s1" value="1  Packet payload (NetworkSession.SendInternal: Reset writer, Put(typeByte), message.Write(writer), peer.Send)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="wf-1"><mxGeometry x="20" y="40" width="1300" height="22" as="geometry"/></mxCell>
        <mxCell id="wf-lh" value="LiteNetLib packet header&lt;br&gt;(added by LiteNetLib: 1 byte unreliable,&lt;br&gt;4 bytes channeled; fragment/ack info)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="wf-1"><mxGeometry x="20" y="70" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="wf-tb" value="type byte&lt;br&gt;1 byte" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="wf-1"><mxGeometry x="360" y="70" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="wf-mb" value="message body&lt;br&gt;written by INetworkMessage.Write(NetDataWriter)&lt;br&gt;no length prefix: the datagram length ends the body" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="wf-1"><mxGeometry x="540" y="70" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="wf-n1" value="Receiver: NetworkMessages.CreateFromWire(typeByte) -&amp;gt; rented instance -&amp;gt; Read(reader). Unknown byte: UnknownMessageType error, connection kept. Short body: MalformedMessage error.&lt;br&gt;Unreliable message larger than the MTU: NetworkErrorCode.PacketTooLarge." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="wf-1"><mxGeometry x="20" y="148" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="wf-s2" value="2  Type byte" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="wf-1"><mxGeometry x="20" y="200" width="600" height="22" as="geometry"/></mxCell>
