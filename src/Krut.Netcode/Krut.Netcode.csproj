<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1590;CS1591;CS1572;CS1573;CS1574;CS1734;CS0419</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Krut.Netcode</PackageId>
    <Version>0.1.0</Version>
    <Description>Authoritative-server netcode for .NET on LiteNetLib: handshake, fixed tick clock, time sync, client prediction and reconciliation, snapshot interpolation and a link simulator.</Description>
    <PackageTags>netcode;multiplayer;networking;gamedev;prediction;reconciliation;litenetlib</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/Cedsson/Krut.Netcode/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Symbols and SourceLink">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Krut.Netcode.Tests" />
  </ItemGroup>
</Project>